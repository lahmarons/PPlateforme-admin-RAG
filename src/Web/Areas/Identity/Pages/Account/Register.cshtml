@page
@model IdaraTech.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inscription citoyen</title>
    <link rel="stylesheet" href="https://unpkg.com/primeicons/primeicons.css">
    <style>
        :root { --primary: #10b981; --surface: #ffffff; --bg1: #0f172a; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Inter, Arial, sans-serif; min-height: 100vh; background: radial-gradient(circle at top left, #1f2937, var(--bg1) 60%, #020617); color: #e5e7eb; display: grid; place-items: center; }
        .shell { width: min(1100px, calc(100vw - 2rem)); display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: center; }
        .hero { padding: 2rem; }
        .hero h1 { margin: 0 0 .75rem; font-size: 2.5rem; }
        .hero p { margin: 0; color: #cbd5e1; line-height: 1.6; }
        .card { background: rgba(255,255,255,.96); color: #0f172a; border-radius: 28px; padding: 2rem; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
        .brand { text-align: center; margin-bottom: 1.5rem; }
        .brand .icon { width: 64px; height: 64px; border-radius: 20px; background: linear-gradient(135deg, var(--primary), #22c55e); display: grid; place-items: center; color: white; margin: 0 auto .75rem; font-size: 1.5rem; }
        .field { margin-bottom: 1rem; }
        .field label { display:block; font-weight: 600; margin-bottom: .35rem; }
        .field input { width: 100%; border: 1px solid #d1d5db; border-radius: 14px; padding: .95rem 1rem; font-size: 1rem; }
        .field input:focus { outline: 2px solid rgba(16,185,129,.2); border-color: var(--primary); }
        .actions { display: grid; gap: .75rem; }
        .btn { display:inline-flex; align-items:center; justify-content:center; gap:.5rem; width:100%; border:0; border-radius: 14px; padding: .95rem 1rem; text-decoration:none; cursor:pointer; font-weight: 700; }
        .btn-primary { background: linear-gradient(135deg, var(--primary), #22c55e); color: white; }
        .btn-secondary { background: #e5e7eb; color: #111827; }
        .error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 12px; padding: .8rem 1rem; margin-bottom: 1rem; }
        @@media (max-width: 900px) { .shell { grid-template-columns: 1fr; } .hero { order: 2; text-align:center; } }
    </style>
</head>
<body>
    <div class="shell">
        <div class="hero">
            <h1>Créer un compte citoyen</h1>
            <p>Inscrivez-vous pour accéder à votre espace citoyen, suivre vos demandes et utiliser les services de l’application.</p>
        </div>
        <div class="card">
            <div class="brand">
                <div class="icon"><i class="pi pi-user-plus"></i></div>
                <h2>Inscription</h2>
                <p>Compte citoyen</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="error">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="field">
                    <label asp-for="Input.Nom"></label>
                    <input asp-for="Input.Nom" />
                </div>
                <div class="field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" />
                </div>
                <div class="field">
                    <label asp-for="Input.Telephone"></label>
                    <input asp-for="Input.Telephone" />
                </div>
                <div class="field">
                    <label asp-for="Input.Adresse"></label>
                    <input asp-for="Input.Adresse" />
                </div>
                <div class="field">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" type="password" />
                </div>
                <div class="field">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" type="password" />
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn-primary">Créer le compte</button>
                    <a class="btn btn-secondary" href="/connexion">Retour au choix d’espace</a>
                    <a href="/Identity/Account/Login">Déjà inscrit ? Se connecter</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
